# Neon Postgres connection string
DATABASE_URL=
# Long random string used to sign admin sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# First-login credentials for the dashboard (change them in Admin > Account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Gmail account that receives contact-form messages + its App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
